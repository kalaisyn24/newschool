# MySQL / MariaDB (OSPanel default: root with empty password)
DATABASE_URL="mysql://root:@127.0.0.1:3306/online_school"

# Public base URL used in e-mail links
APP_URL="http://localhost:3000"

# SMTP. If SMTP_HOST is empty, e-mails are written to storage/mail-outbox/ and logged to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Онлайн-школа <no-reply@example.com>"

# Seed admin account (prisma db seed)
SEED_ADMIN_EMAIL="admin@school.local"
SEED_ADMIN_PASSWORD="admin12345"
